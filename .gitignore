!firmware/z80-boot-rom/cpm/msxfont.img
__pycache__/
firmware/avr-1284p/src/stage1_rom.h

# kicad / editor temp
*.sch-bak
*.kicad_pcb-bak
fp-info-cache
*_cache*
.*.swp

# drive-a/ and drive-b/ are staging folders for the SD card images. Only the
# starter binaries are tracked; anything else you drop in there (Zork, Turbo
# Pascal etc.) is copyrighted third-party software and stays untracked.
/drive-a/*
/drive-b/*
!/drive-a/HELLO.COM
!/drive-b/BREAKOUT.COM

# kc-z80-comp-emu build outputs
/kc-z80-comp-emu/*_harness
/kc-z80-comp-emu/build/
